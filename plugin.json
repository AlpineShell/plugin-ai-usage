{
  "id": "alpine-shell.ai-usage",
  "name": "AI Usage",
  "version": "1.0.2",
  "apiVersion": 1,
  "description": "Claude, Gemini, and OpenCode Go usage limits, live in your topbar.",
  "author": {
    "name": "Alpine Shell"
  },
  "repository": "https://github.com/AlpineShell/plugin-ai-usage",
  "icon": "assets/icon.png",
  "main": "backend.js",
  "renderer": "index.js",
  "contributes": {
    "topbarWidgets": [
      {
        "slot": "left",
        "order": 0
      }
    ],
    "settings": [
      {
        "key": "claudeEnabled",
        "type": "toggle",
        "label": "Claude",
        "default": true
      },
      {
        "key": "geminiEnabled",
        "type": "toggle",
        "label": "Gemini",
        "default": true
      },
      {
        "key": "opencodeEnabled",
        "type": "toggle",
        "label": "OpenCode Go",
        "default": true
      },
      {
        "key": "pillIcon",
        "type": "select",
        "label": "Topbar icon",
        "default": "clawd",
        "options": [
          { "value": "clawd", "label": "Clawd" },
          { "value": "claude", "label": "Claude" },
          { "value": "gemini", "label": "Gemini" },
          { "value": "opencode", "label": "OpenCode" },
          { "value": "auto", "label": "Active provider" },
          { "value": "none", "label": "None" }
        ]
      },
      {
        "key": "barSource",
        "type": "select",
        "label": "Topbar bar",
        "default": "highest",
        "options": [
          { "value": "highest", "label": "Highest usage" },
          { "value": "claude", "label": "Claude" },
          { "value": "gemini", "label": "Gemini" },
          { "value": "opencode", "label": "OpenCode Go" }
        ]
      }
    ],
    "settingsPages": [
      {
        "label": "AI Usage",
        "export": "SettingsPage"
      }
    ]
  },
  "marketplace": {
    "shortDescription": "Claude, Gemini, and OpenCode Go limits, live in your topbar.",
    "readme": "README.md",
    "category": "developer",
    "keywords": ["ai", "usage", "claude", "gemini", "opencode", "limits", "topbar"]
  }
}
