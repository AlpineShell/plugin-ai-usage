{
  "id": "alpine-shell.ai-usage",
  "name": "AI Usage",
  "version": "1.2.4",
  "apiVersion": 1,
  "description": "Claude, Antigravity, and OpenCode usage limits, live in your topbar.",
  "author": {
    "name": "Alpine Shell"
  },
  "repository": "https://github.com/AlpineShell/plugin-ai-usage",
  "icon": "assets/icon.png",
  "main": "backend.js",
  "renderer": "index.js",
  "contributes": {
    "topbarWidgets": [
      {
        "slot": "left",
        "order": 0
      }
    ],
    "settings": [
      {
        "key": "pillIcon",
        "type": "select",
        "label": "Topbar icon",
        "default": "none",
        "options": [
          { "value": "clawd", "label": "Clawd" },
          { "value": "claude", "label": "Claude" },
          { "value": "antigravity", "label": "Antigravity" },
          { "value": "opencode", "label": "OpenCode" },
          { "value": "auto", "label": "Active provider" },
          { "value": "none", "label": "None" }
        ]
      },
      {
        "key": "barSource",
        "type": "select",
        "label": "Topbar bar",
        "default": "all",
        "options": [
          { "value": "all", "label": "All providers" },
          { "value": "highest", "label": "Highest usage" },
          { "value": "claude", "label": "Claude" },
          { "value": "antigravity", "label": "Antigravity" },
          { "value": "opencode", "label": "OpenCode" }
        ]
      }
    ],
    "settingsPages": [
      {
        "label": "AI Usage",
        "export": "SettingsPage"
      }
    ]
  },
  "marketplace": {
    "shortDescription": "Claude, Antigravity, and OpenCode limits, live in your topbar.",
    "readme": "README.md",
    "category": "developer",
    "keywords": ["ai", "usage", "claude", "antigravity", "gemini", "opencode", "limits", "topbar"]
  }
}
